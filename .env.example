# ==============================================================================
# Agent Holmes — Environment Configuration Reference
# ==============================================================================
# Copy this file to:
#   backend/.env        (for local FastAPI backend development)
#   frontend/.env.local (for local Next.js frontend development)
# Or configure these in your Render / Vercel deployment dashboards.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js / Vercel)
# ------------------------------------------------------------------------------
# Public REST API URL consumed by the browser / frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public WebSocket URL consumed by the browser for live case streaming
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML Verification (content value from meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI / Render)
# ------------------------------------------------------------------------------
# Environment mode (development / production)
ENVIRONMENT=development

# Allowed CORS origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional explicit frontend URL added to CORS whitelist
FRONTEND_URL=http://localhost:3000

# Database Connection (SQLite locally, PostgreSQL in production)
DATABASE_URL=sqlite:///./holmes.db

# Directory for ephemeral workspace sandboxes
WORKSPACES_DIR=./workspaces

# AI Provider Configuration (Bob / IBM Granite / Ollama)
AI_PROVIDER=bob
BOB_API_BASE=http://localhost:11434
BOB_API_KEY=
BOB_MODEL=ibm-granite-code

# Execution & Investigation Limits
DEFAULT_TIMEOUT_SECONDS=30
MAX_INVESTIGATION_STEPS=50
MAX_PATCH_ATTEMPTS=3
