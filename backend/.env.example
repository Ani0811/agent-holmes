# Agent Holmes Backend Configuration
ENVIRONMENT=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_PROVIDER=bob
BOB_API_BASE=http://localhost:11434
BOB_API_KEY=
BOB_MODEL=ibm-granite-code

DATABASE_URL=sqlite:///./holmes.db
WORKSPACES_DIR=./workspaces
DEFAULT_TIMEOUT_SECONDS=30
MAX_INVESTIGATION_STEPS=50
MAX_PATCH_ATTEMPTS=3
